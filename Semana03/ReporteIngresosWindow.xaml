<Window x:Class="Semana03.ReporteIngresosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reporte de Ingresos" Height="520" Width="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="LISTADO Y REPORTE DE INGRESOS" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

        <!-- Filtros de Búsqueda con evento en tiempo real -->
        <GroupBox Header="Filtros de Búsqueda (En Tiempo Real)" Grid.Row="1" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- a. Fecha Inicio -->
                <TextBlock Text="Fecha Inicio:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <DatePicker x:Name="dtpFechaInicio" Grid.Row="0" Grid.Column="1" Height="24" SelectedDateChanged="Filtro_Cambiado"/>

                <!-- b. Fecha Fin -->
                <TextBlock Text="Fecha Fin:" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center"/>
                <DatePicker x:Name="dtpFechaFin" Grid.Row="0" Grid.Column="4" Height="24" SelectedDateChanged="Filtro_Cambiado"/>

                <!-- c. Placa -->
                <TextBlock Text="Placa:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtFiltroPlaca" Grid.Row="1" Grid.Column="1" Height="24" VerticalContentAlignment="Center" TextChanged="Filtro_Cambiado"/>

                <!-- d. Nombre Conductor -->
                <TextBlock Text="Nombre Conductor:" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center"/>
                <TextBox x:Name="txtFiltroConductor" Grid.Row="1" Grid.Column="4" Height="24" VerticalContentAlignment="Center" TextChanged="Filtro_Cambiado"/>

                <!-- e. Nombre Producto -->
                <TextBlock Text="Nombre Producto:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtFiltroProducto" Grid.Row="2" Grid.Column="1" Height="24" VerticalContentAlignment="Center" TextChanged="Filtro_Cambiado"/>

                <!-- Botón Buscar opcional para limpiar/refrescar -->
                <Button Content="Limpiar Filtros" Grid.Row="2" Grid.Column="4" Height="26" Width="110" HorizontalAlignment="Right" Click="btnLimpiar_Click" Background="#6C757D" Foreground="White" FontWeight="Bold"/>
            </Grid>
        </GroupBox>

        <DataGrid x:Name="dgReporteIngresos" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaHora, StringFormat=\{0:dd/MM/yyyy\}}" Width="90"/>
                <DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="90"/>
                <DataGridTextColumn Header="Turno" Binding="{Binding Turno}" Width="80"/>
                <DataGridTextColumn Header="Conductor" Binding="{Binding NombreConductor}" Width="150"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="120"/>
                <DataGridTextColumn Header="Peso (kg)" Binding="{Binding PesoIngreso}" Width="90"/>
                <DataGridTextColumn Header="Transporte" Binding="{Binding Transporte}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>